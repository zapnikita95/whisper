# Скопируй рядом как whisper_codesign_local.env и поправь при необходимости (файл в .gitignore).
# Строка личности: security find-identity -v -p codesigning
#
# После заполнения этого файла обычный packaging/build_mac_app.sh сам подписывает Developer ID
# (в т.ч. из Cursor). Релиз .app + DMG: bash packaging/mac/release_mac_signed.sh

export WHISPER_MAC_CODESIGN_IDENTITY='Developer ID Application: Nikita Zaporozhets (Y52BT2N4L8)'

# Вариант A — пароль связки «Вход» в открытом виде (только локально, не коммитить):
# export WHISPER_LOGIN_KEYCHAIN_PASSWORD='…'

# Вариант B — пароль хранится в связке как generic password (без plaintext в файле).
# Один раз в терминале:
#   read -rsp "Пароль связки Вход: " KC_PASS; echo ""
#   security add-generic-password -a "$USER" -s "whisper-mac-release" -w "$KC_PASS" -U "$HOME/Library/Keychains/login.keychain-db"
# Потом раскомментируй:
# export WHISPER_LOGIN_KEYCHAIN_PASSWORD_CMD='security find-generic-password -w -a "$USER" -s "whisper-mac-release"'
