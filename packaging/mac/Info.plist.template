<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>WhisperClient</string>
    <key>CFBundleIdentifier</key>
    <string>com.zapnikita95.WhisperClient</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleName</key>
    <string>WhisperClient</string>
    <key>CFBundleDisplayName</key>
    <string>Whisper Client</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.3.0</string>
    <key>CFBundleVersion</key>
    <string>15</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <key>NSMicrophoneUsageDescription</key>
    <string>Whisper Client использует микрофон для записи голоса и распознавания речи.</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>Whisper Client вставляет распознанный текст в активное приложение.</string>
    <key>NSUserNotificationsUsageDescription</key>
    <string>Whisper Client показывает статус записи и результат распознавания.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Whisper Client подключается к вашему серверу распознавания в локальной сети или Tailscale.</string>

    <key>NSAppSleepDisabled</key>
    <true/>
    <key>NSRequiresAppNap</key>
    <false/>

    <key>LSBackgroundOnly</key>
    <false/>
    <key>LSUIElement</key>
    <true/>

    <key>NSPrincipalClass</key>
    <string>NSApplication</string>

    <!-- HTTP к пользовательскому серверу (Tailscale/LAN), иначе ATS -1022 -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>

    <key>LSEnvironment</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Library/Frameworks/Python.framework/Versions/Current/bin</string>
    </dict>
</dict>
</plist>
